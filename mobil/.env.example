# Mobil ilova muhit o'zgaruvchilari
# Expo SDK 54+ uchun EXPO_PUBLIC_ prefiksi majburiy

# Backend API manzili (production: fvv.xron.uz)
EXPO_PUBLIC_API_URL=https://fvv.xron.uz/api

# Lokal development uchun quyidagilardan birini ishlating:
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# iOS simulator:    EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Haqiqiy qurilma:  EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
