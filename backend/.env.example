# ============================================================
# XAVFSIZ XONADON — Backend muhit o'zgaruvchilari (.env)
# Ushbu fayldan nusxa oling: cp .env.example .env
# Faqat .env.example versiya nazoratida saqlanadi.
# ============================================================

# ============ Ilova ============
APP_ENV=development
DEBUG=true

# ============ Ma'lumotlar bazasi ============
POSTGRES_DB=xavfsiz_xonadon
POSTGRES_USER=xavfsiz_user
POSTGRES_PASSWORD=almashtirilsin_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xavfsiz_user:almashtirilsin_2026@localhost:5432/xavfsiz_xonadon

# ============ JWT ============
# Majburiy (APP_ENV=production'da bo'sh bo'lsa backend ishga tushmaydi).
# Generatsiya:  openssl rand -hex 32
# Dev'da bo'sh qoldirsangiz backend har start'da tasodifiy qiymat ishlatadi.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============ Bcrypt ============
BCRYPT_COST=12

# ============ Telegram bot ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# ============ Foto ============
UPLOAD_DIR=/app/uploads
MAX_FOTO_SIZE_MB=10

# ============ CORS ============
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============ Expo Push ============
EXPO_ACCESS_TOKEN=

# ============ Backup ============
BACKUP_DIR=/backups
BACKUP_ENCRYPT_PASSWORD=

# ============ Ish vaqti (format: soat) ============
ISH_BOSHLANISH_SOAT=9
ISH_TUGASH_SOAT=18

# ============ Lokatsiya log saqlash muddati (kun) ============
LOKATSIYA_SAQLASH_KUN=90

# ============ Rate limit ============
LOGIN_RATE_LIMIT=5/15m
