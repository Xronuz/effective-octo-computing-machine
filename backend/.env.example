# ============================================================
# XAVFSIZ XONADON — Backend muhit o'zgaruvchilari (.env)
# Ushbu fayldan nusxa oling: cp .env.example .env
# Faqat .env.example versiya nazoratida saqlanadi.
# ============================================================

# ============ Ilova ============
APP_ENV=development
DEBUG=true

# ============ Ma'lumotlar bazasi ============
POSTGRES_DB=xavfsiz_xonadon
POSTGRES_USER=xavfsiz_user
POSTGRES_PASSWORD=almashtirilsin_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xavfsiz_user:almashtirilsin_2026@localhost:5432/xavfsiz_xonadon

# ============ JWT (kamida 64 belgi, ishlab chiqarishda almashtirilsin!) ============
JWT_SECRET=0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============ Bcrypt ============
BCRYPT_COST=12

# ============ Telegram bot ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# ============ Foto ============
UPLOAD_DIR=/app/uploads
MAX_FOTO_SIZE_MB=10

# ============ CORS ============
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============ Expo Push ============
EXPO_ACCESS_TOKEN=

# ============ Backup ============
BACKUP_DIR=/backups
BACKUP_ENCRYPT_PASSWORD=

# ============ Ish vaqti (format: soat) ============
ISH_BOSHLANISH_SOAT=9
ISH_TUGASH_SOAT=18

# ============ Lokatsiya log saqlash muddati (kun) ============
LOKATSIYA_SAQLASH_KUN=90

# ============ Rate limit ============
LOGIN_RATE_LIMIT=5/15m
